---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import StatTilePart from '@fx/components/StatTilePart.astro';
import SegmentBarPart from '@fx/components/SegmentBarPart.astro';
import RoleItem from './RoleItemPart.astro';
import { getProfile, siteFacts } from '@data/profile';
import { getLocale } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const { experience, education } = getProfile(locale);

const stats = [
  { value: '20+', label: s.career.stats.years },
  { value: '18', label: s.career.stats.leading },
  { value: '4', label: s.career.stats.companies },
];

// Company eras for the ribbon; widths are proportional to duration. Company
// names and year ranges are the same in every language.
const eras = [
  { label: 'Ubisoft', note: '’05–’08', weight: 3.5 },
  { label: 'TeamNet', note: '’08–’09', weight: 1 },
  { label: 'Consignor', note: '’09–’22', weight: 13 },
  { label: 'nShift', note: '’22–now', weight: 4.7, highlight: true },
];

const cv = locale === 'ro' ? '/cv-ro.pdf' : '/cv-en.pdf';
---

<BaseLayout
  title={`${s.career.metaTitle} — ${siteFacts.name}`}
  description={s.career.metaDescription}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="kicker">{s.career.kicker}</p>
      <h1 class="title-page mt-2">{s.career.heading}</h1>
      <p class="lede">{s.career.lede}</p>
    </div>
    <a href={cv} download={`${s.career.downloadFile}.pdf`} class="btn btn-primary">
      <Icon name="lucide:download" class="h-3.5 w-3.5" aria-hidden="true" />
      {s.career.download}
    </a>
  </div>

  <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {stats.map((stat) => <StatTilePart value={stat.value} label={stat.label} />)}
  </div>

  <SegmentBarPart segments={eras} ariaLabel={s.career.timeline} />

  <ol class="border-line relative mt-10 space-y-12 border-s">
    {experience.map((role) => <RoleItem role={role} />)}
  </ol>

  <h2 class="title-section mt-14 flex items-center gap-2.5">
    <Icon name="lucide:graduation-cap" class="text-accent h-6 w-6" aria-hidden="true" />
    {s.career.education}
  </h2>
  <ul class="mt-4 space-y-4">
    {
      education.map((entry) => (
        <li>
          <p class="text-ink font-medium">{entry.degree}</p>
          <p class="text-faint text-sm">
            {entry.school} · {entry.period}
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
