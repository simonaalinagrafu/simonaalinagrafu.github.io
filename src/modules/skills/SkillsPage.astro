---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getProfile, siteFacts } from '@data/profile';
import { getLocale } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const { skills } = getProfile(locale);
---

<BaseLayout
  title={`${s.skills.metaTitle} — ${siteFacts.name}`}
  description={s.skills.metaDescription}
>
  <p class="kicker">{s.skills.kicker}</p>
  <h1 class="title-page mt-2">{s.skills.heading}</h1>
  <p class="lede">{s.skills.lede}</p>

  <!-- An editorial list on hairlines rather than a card grid: each group is a
       heading with its own rule, not a box. -->
  <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {
      skills.map((cat) => (
        <section class="border-line border-t pt-6">
          <div class="flex items-center gap-3">
            <div class="icon-tile">
              <Icon name={cat.icon} class="h-4 w-4" aria-hidden="true" />
            </div>
            <h2 class="title-item">{cat.group}</h2>
          </div>
          <p class="text-muted mt-3 text-sm leading-relaxed">{cat.blurb}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {cat.items.map((item) => (
              <li class="chip text-sm">{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
