---
// Masthead above the navigation, on every page — the site's letterhead, and
// the only place the name and the role line appear (the home hero deliberately
// says neither, so nothing is duplicated).
//
// The artwork — paper ground, slanted accent panel, five-bar mark — is the
// supplied design, but drawn entirely in theme tokens rather than fixed hex,
// so it follows the theme picker like the rest of the site. The text is live
// too: the name and the localized short title, set in the site's own faces.
//
// Two forms: the wide SVG from ~640px up, and a compact bar on phones, where
// the wide artwork's type would shrink to a few pixels.
import { getProfile, siteFacts } from '@data/profile';
import { getLocale } from '@fx/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const { site } = getProfile(locale);
---

<div class="w-full">
  <!-- Phones: same palette, stacked, at a size that stays readable. -->
  <div class="bg-chip flex items-center justify-between gap-4 px-4 py-3 sm:hidden">
    <div class="min-w-0">
      <p class="font-display text-ink truncate text-xl font-semibold">{siteFacts.name}</p>
      <p class="text-accent mt-0.5 truncate text-[11px]">{site.titleShort}</p>
    </div>
    <svg viewBox="0 0 214 120" class="h-7 w-auto shrink-0" aria-hidden="true" focusable="false">
      <rect width="30" height="120" fill="var(--t-accent-strong)"></rect>
      <rect x="46" width="30" height="98" fill="var(--t-grad-b)"></rect>
      <rect x="92" width="30" height="120" fill="var(--t-accent-solid)"></rect>
      <rect x="138" width="30" height="75" fill="var(--t-label)"></rect>
      <rect x="184" width="30" height="120" fill="var(--t-accent-strong)"></rect>
    </svg>
  </div>

  <!-- Tablet and up: the artwork as drawn. -->
  <svg
    viewBox="0 0 1200 150"
    class="hidden h-auto w-full sm:block"
    role="img"
    aria-label={`${siteFacts.name} — ${site.titleShort}`}
  >
    <rect width="1200" height="150" fill="var(--t-chip)"></rect>
    <path d="M760 0h440v150H737Z" fill="var(--t-accent-solid)"></path>
    <g transform="translate(860 25)">
      <rect width="30" height="100" fill="var(--t-accent-strong)"></rect>
      <rect x="46" width="30" height="82" fill="var(--t-grad-b)"></rect>
      <rect x="92" width="30" height="100" fill="var(--t-chip)" fill-opacity="0.9"></rect>
      <rect x="138" width="30" height="62" fill="var(--t-label)"></rect>
      <rect x="184" width="30" height="100" fill="var(--t-accent-strong)"></rect>
    </g>
    <text x="80" y="78" class="font-display" font-size="48" font-weight="600" fill="var(--t-ink)"
      >{siteFacts.name}</text
    >
    <text x="80" y="116" class="font-sans" font-size="23" fill="var(--t-accent)"
      >{site.titleShort}</text
    >
  </svg>
</div>
