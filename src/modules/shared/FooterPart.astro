---
import { navItems } from './nav';
import { siteFacts } from '@data/profile';
import { getLocale, localePath } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const path = Astro.url.pathname;
const locale = getLocale(path);
const s = t(locale);
---

<footer class="border-line border-t">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="font-display text-ink font-semibold">{siteFacts.name}</p>
        <p class="text-faint mt-1 max-w-xs text-sm">{s.footer.blurb}</p>
      </div>
      <nav class="text-muted flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          navItems.map((item) => (
            <a href={localePath(locale, item.href)} class="hover:text-accent">
              {s.nav[item.id]}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="text-faint mt-6 text-sm">
      © {new Date().getFullYear()}
      {siteFacts.name} ·
      <a href={siteFacts.github} class="hover:text-accent">{s.header.github}</a> ·
      <a href={siteFacts.linkedin} class="hover:text-accent">{s.header.linkedin}</a> ·
      <a href={localePath(locale, '/rss.xml')} class="hover:text-accent">{s.footer.rss}</a>
    </p>
  </div>
</footer>
