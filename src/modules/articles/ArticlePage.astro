---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import { articles, getArticles } from './registry';
import { siteFacts } from '@data/profile';
import { getLocale, localePath } from '@fx/lib/i18n';
import { t } from '@i18n/index';

// The same ids in every language — a translation is mandatory, so both route
// patterns (/articles/[id] and /en/articles/[id]) emit the same set.
export async function getStaticPaths() {
  return articles.map((article) => ({ params: { id: article.id } }));
}

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const { id } = Astro.params;

const article = getArticles(locale).find((a) => a.id === id)!;

// Resolve the article body by convention: content/<id>/ArticlePart.<locale>.astro
const contentModules = import.meta.glob<{ default: any }>('./content/*/ArticlePart.*.astro', {
  eager: true,
});
const key = `./content/${id}/ArticlePart.${locale}.astro`;
const module = contentModules[key];
if (!module) {
  throw new Error(
    `Article "${id}" has no ${locale.toUpperCase()} translation. ` +
      `Every article must exist in all languages — create ${key.replace('./', 'src/modules/articles/')}.`,
  );
}
const Content = module.default;
---

<BaseLayout title={`${article.title} — ${siteFacts.name}`} description={article.description}>
  <article>
    <p class="text-faint text-sm">
      {
        article.pubDate.toLocaleDateString(s.dateLocale, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
    </p>
    <h1 class="title-page mt-2">{article.title}</h1>
    {
      article.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {article.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
    <div class="prose-article mt-8">
      <Content />
    </div>
  </article>
  <p class="mt-10">
    <a href={localePath(locale, '/articles/')} class="link-accent">{s.articles.back}</a>
  </p>
</BaseLayout>
