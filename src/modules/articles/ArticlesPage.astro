---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import { articlesByDate } from './registry';
import { siteFacts } from '@data/profile';
import { getLocale, localePath } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const articles = articlesByDate(locale);
---

<BaseLayout
  title={`${s.articles.metaTitle} — ${siteFacts.name}`}
  description={s.articles.metaDescription}
>
  <p class="kicker">{s.articles.kicker}</p>
  <h1 class="title-page mt-2">{s.articles.heading}</h1>
  <p class="lede">
    {s.articles.ledeBefore}<a href={localePath(locale, '/rss.xml')} class="link-accent"
      >{s.articles.ledeRssLink}</a
    >{s.articles.ledeAfter}
  </p>

  <ul class="mt-8 space-y-8">
    {
      articles.map((article) => (
        <li>
          <a href={localePath(locale, `/articles/${article.id}/`)} class="group block">
            <p class="text-faint text-sm">
              {article.pubDate.toLocaleDateString(s.dateLocale, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            <h2 class="title-item group-hover:text-accent mt-1">{article.title}</h2>
            <p class="text-muted mt-2">{article.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
