---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import IconCardPart from '@fx/components/IconCardPart.astro';
import StatTilePart from '@fx/components/StatTilePart.astro';
import { getProfile, siteFacts } from '@data/profile';
import { getLocale, localePath } from '@fx/lib/i18n';
import { t } from '@i18n/index';
import type { StatId, DoingId, ValueId, PrincipleId } from '@i18n/types';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const { site, experience } = getProfile(locale);

const current = experience[0];

// Display order and icons live here; the words live in the i18n dictionaries,
// keyed by the same ids — so neither can drift out of step with the other.

// Reach and practice: three figures, then how the work is actually done. The
// lifecycle detail sits in the hero sentence above, so one tile points at it
// rather than spending six. The AI tiles say what I build and how I build —
// they describe the systems and the practice, never me.
const statOrder: StatId[] = ['years', 'apps', 'requests', 'phases', 'aiSystems', 'aiAssisted'];

const doingIcons: Record<DoingId, string> = {
  engineering: 'lucide:code-xml',
  leadership: 'lucide:users',
  aiAssisted: 'lucide:hammer',
  aiSystems: 'lucide:sparkles',
};
const doingOrder: DoingId[] = ['engineering', 'leadership', 'aiAssisted', 'aiSystems'];

// Written from the employer's point of view rather than mine — one line each,
// stating a benefit rather than restating a fact the tiles above already carry.
const valueIcons: Record<ValueId, string> = {
  ship: 'lucide:rocket',
  build: 'lucide:wrench',
  handoff: 'lucide:workflow',
  ai: 'lucide:lightbulb',
  load: 'lucide:gauge',
  grow: 'lucide:sprout',
};
const valueOrder: ValueId[] = ['ship', 'build', 'handoff', 'ai', 'load', 'grow'];

// What keeps me in this work, as opposed to what I am paid to do.
const principleIcons: Record<PrincipleId, string> = {
  curiosity: 'lucide:telescope',
  evolution: 'lucide:trending-up',
  teams: 'lucide:handshake',
  impact: 'lucide:target',
};
const principleOrder: PrincipleId[] = ['curiosity', 'evolution', 'teams', 'impact'];

const monogram = siteFacts.name
  .split(' ')
  .map((word) => word[0])
  .join('');
---

<BaseLayout title={`${siteFacts.name} — ${s.home.metaTitle}`} description={site.tagline}>
  <section class="relative py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="blob bg-blob-a -top-24 -right-24 h-80 w-80"></div>
      <div class="blob bg-blob-b top-32 -left-24 h-64 w-64"></div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-8 lg:flex-nowrap">
      <div class="max-w-3xl min-w-0">
        <p class="text-accent font-medium">{s.home.greeting}</p>
        <h1 class="title-hero mt-1">
          {siteFacts.name}
        </h1>
        <p class="text-muted mt-3 text-xl">{site.title}</p>
        <p class="mt-5 text-lg leading-relaxed">
          {site.intro}
        </p>
      </div>
      <div class="hidden shrink-0 items-center justify-center lg:flex" aria-hidden="true">
        <div
          class="from-grad-a to-grad-b shadow-accent-solid/20 rounded-full bg-gradient-to-br p-1 shadow-xl"
        >
          <div class="bg-bg flex h-36 w-36 items-center justify-center rounded-full">
            <span
              class="font-display from-grad-a to-grad-b bg-gradient-to-br bg-clip-text text-4xl font-bold text-transparent"
              >{monogram}</span
            >
          </div>
        </div>
      </div>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localePath(locale, '/career/')} class="btn btn-primary">{s.home.ctaCareer}</a>
      <a href={localePath(locale, '/articles/')} class="btn btn-ghost">{s.home.ctaWriting}</a>
    </div>
  </section>

  <section class="py-8">
    <p class="kicker">{s.home.kickerReach}</p>
    <!-- A strip between hairlines rather than a card grid, so the facts read
         differently from the capability cards below. -->
    <div
      class="border-line mt-5 grid grid-cols-2 gap-x-6 gap-y-8 border-y py-8 sm:grid-cols-3 sm:gap-x-10"
    >
      {
        statOrder.map((id) => (
          <StatTilePart value={s.home.stats[id].value} label={s.home.stats[id].label} bare />
        ))
      }
    </div>
  </section>

  <section class="py-8">
    <p class="kicker">{s.home.kickerDoing}</p>
    <div class="mt-4 grid gap-6 sm:grid-cols-2">
      {
        doingOrder.map((id) => (
          <IconCardPart icon={doingIcons[id]} title={s.home.doing[id].title}>
            {s.home.doing[id].body.replace('{company}', current.company)}
          </IconCardPart>
        ))
      }
    </div>
  </section>

  <section class="py-8">
    <p class="kicker">{s.home.kickerWorking}</p>
    <h2 class="title-section mt-2">{s.home.headingWorking}</h2>
    <!-- The only panel on a page of strips, cards and lists — that shape is
         enough to mark the zone, so the colour stays out of it. -->
    <div
      class="bg-tint border-line mt-4 grid gap-8 rounded-2xl border p-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        valueOrder.map((id) => (
          <div>
            <div class="icon-tile">
              <Icon name={valueIcons[id]} class="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="font-display text-ink mt-4 text-lg font-semibold">
              {s.home.value[id].title}
            </h3>
            <p class="text-muted mt-1.5 text-sm leading-relaxed">{s.home.value[id].body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="py-8">
    <p class="kicker">{s.home.kickerPrinciples}</p>
    <h2 class="title-section mt-2">{s.home.headingPrinciples}</h2>
    <!-- A numbered manifesto rather than another card grid — principles are not
         features, and the form should say so before the words do. -->
    <div class="mt-6 grid gap-x-12 gap-y-9 sm:grid-cols-2">
      {
        principleOrder.map((id) => (
          <div class="flex gap-4">
            <Icon
              name={principleIcons[id]}
              class="text-label mt-0.5 h-6 w-6 shrink-0"
              aria-hidden="true"
            />
            <div>
              <h3 class="font-display text-ink font-semibold">{s.home.principles[id].title}</h3>
              <p class="text-muted mt-1.5 text-sm leading-relaxed">{s.home.principles[id].body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
