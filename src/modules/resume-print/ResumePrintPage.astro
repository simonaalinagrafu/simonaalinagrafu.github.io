---
// Print source for the CV PDFs, rendered entirely from src/data/profile/.
// One page per locale: /resume-print/ → public/cv-ro.pdf,
//                      /en/resume-print/ → public/cv-en.pdf
// Regenerate both after any profile change with:  npm run cv
// This page is noindex and excluded from the sitemap (see astro.config.mjs).
import './resume-print.css';
import { getProfile } from '@data/profile';
import { getLocale } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const { site, experience, skills, education, achievements } = getProfile(locale);

const keyAchievement = achievements[0];

const linkedinLabel = site.linkedin.replace('https://www.', '');
const siteLabel = site.url.replace('https://', '');
const telHref = `tel:${site.phone.replace(/\s/g, '')}`;

/** Bullets are written as "Lead-in: detail" — split so the lead-in can be bold. */
function splitBullet(b: string) {
  const i = b.indexOf(': ');
  return i > 0 ? { title: b.slice(0, i), rest: b.slice(i + 2) } : { title: null, rest: b };
}
---

<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{site.name} — {s.career.metaTitle}</title>
  </head>
  <body>
    <header>
      <h1>{site.name}</h1>
      <div class="subtitle">{site.title}</div>
      <div class="contact">
        <span>{site.location}</span>
        <span><a href={telHref}>{site.phone}</a></span>
        <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
        <span><a href={site.linkedin}>{linkedinLabel}</a></span>
        <span><a href={site.url}>{siteLabel}</a></span>
      </div>
    </header>

    <h2>{s.resume.summary}</h2>
    <p>{site.intro}</p>

    <div class="highlights">
      {s.resume.highlights.map((h) => <div>{h}</div>)}
    </div>

    <h2>{s.resume.skills}</h2>
    <div class="skills">
      {
        skills.map((skill) => (
          <p>
            <b>{skill.group}:</b> {skill.items.join(', ')}
          </p>
        ))
      }
    </div>

    <h2>{s.resume.experience}</h2>
    {
      experience.map((role) => {
        // The Career page carries every bullet; the PDF takes the leading few
        // when a role sets pdfBullets, which caps how long the resume can grow.
        const bullets = role.pdfBullets ? role.bullets.slice(0, role.pdfBullets) : role.bullets;
        return (
          <div class={bullets.length > 5 ? 'role allow-break' : 'role'}>
            <div class="role-head">
              <h3>
                {role.position} · {role.company}, {role.location}
              </h3>
              <span class="period">{role.period}</span>
            </div>
            {role.aboutShort && <p class="about">{role.aboutShort}</p>}
            {role.summary && <p class="summary">{role.summary}</p>}
            <ul>
              {bullets.map((b) => {
                const { title, rest } = splitBullet(b);
                return (
                  <li>
                    {title ? (
                      <Fragment>
                        <b>{title}:</b> {rest}
                      </Fragment>
                    ) : (
                      b
                    )}
                  </li>
                );
              })}
            </ul>
            {role.focus && (
              <p class="tech">
                <span class="tech-label">{s.resume.focus}</span>
                {role.focus.join(' · ')}
              </p>
            )}
          </div>
        );
      })
    }

    <h2>{s.resume.keyAchievement}</h2>
    <div class="role">
      <div class="role-head">
        <h3>{keyAchievement.title}</h3>
        <span class="period">{keyAchievement.role}</span>
      </div>
      <p class="summary">{keyAchievement.description}</p>
    </div>

    <h2>{s.resume.education}</h2>
    {
      education.map((entry) => (
        <div class="edu">
          <b>{entry.degree}</b> — {entry.school}
          {entry.period && <span class="period">({entry.period})</span>}
        </div>
      ))
    }
  </body>
</html>
