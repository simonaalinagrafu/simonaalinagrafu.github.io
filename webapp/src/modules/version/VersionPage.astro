---
// /version — shows webapp/version.json exactly as written, so anyone can
// check which version is live. It is a page, not a bare file: GitHub Pages types
// files by extension, and an extensionless /version would download, not display.
// This page is noindex and excluded from the sitemap (see astro.config.mjs).
import version from '../../../version.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Version</title>
  </head>
  <body>
    <pre>{JSON.stringify(version, null, 2)}</pre>
  </body>
</html>
