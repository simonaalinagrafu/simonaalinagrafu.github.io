---
// Desktop pill navigation.
import { Icon } from 'astro-icon/components';
import { navItems } from './nav';
import { isActive } from '@fx/lib/routing';
import { getLocale, stripLocale, localePath } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const path = Astro.url.pathname;
const locale = getLocale(path);
const s = t(locale);
// Active state is decided on the locale-free path, so /en/career highlights
// the same item /career does.
const bare = stripLocale(path);
---

<nav class="hidden flex-wrap gap-1 text-[15px] sm:flex">
  {
    navItems.map((item) => (
      <a
        href={localePath(locale, item.href)}
        class:list={['nav-pill', isActive(item.href, bare) && 'nav-pill-active']}
      >
        <Icon name={item.icon} class="h-4 w-4" aria-hidden="true" />
        {s.nav[item.id]}
      </a>
    ))
  }
</nav>
