---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import StatTilePart from '@fx/components/StatTilePart.astro';
import SegmentBarPart from '@fx/components/SegmentBarPart.astro';
import RoleItem from './RoleItemPart.astro';
import { getProfile, siteFacts } from '@data/profile';
import { getLocale } from '@fx/lib/i18n';
import { t } from '@i18n/index';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const { experience, education } = getProfile(locale);

// The Everest figure is derived from her start date there (February 2012),
// so it ages on its own.
const year = new Date().getFullYear();
const stats = [
  { value: '20+', label: s.career.stats.years },
  { value: String(year - 2012), label: s.career.stats.everest },
  { value: String(experience.length), label: s.career.stats.companies },
];

// Company eras for the ribbon; widths are proportional to duration. Company
// names and year ranges are the same in every language.
const eras = [
  { label: 'Euromobex', note: '’97–’99', weight: 2 },
  { label: 'Delta', note: '’99–’00', weight: 1.2 },
  { label: 'Europetrolgaz', note: '’00–’01', weight: 0.7 },
  { label: 'Rodata', note: '’01–’02', weight: 1.7 },
  { label: 'RH Printing', note: '’03–’12', weight: 8.8 },
  { label: 'Tipografia Everest', note: `’12–${s.career.now}`, weight: 14.6, highlight: true },
];

const cv = locale === 'ro' ? '/cv-ro.pdf' : '/cv-en.pdf';
---

<BaseLayout
  title={`${s.career.metaTitle} — ${siteFacts.name}`}
  description={s.career.metaDescription}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="kicker">{s.career.kicker}</p>
      <h1 class="title-page mt-2">{s.career.heading}</h1>
      <p class="lede">{s.career.lede}</p>
    </div>
    <a href={cv} download={`${s.career.downloadFile}.pdf`} class="btn btn-primary">
      <Icon name="lucide:download" class="h-3.5 w-3.5" aria-hidden="true" />
      {s.career.download}
    </a>
  </div>

  <!-- Figures on a hairline strip, the same device as the home page. -->
  <div class="border-line mt-10 grid grid-cols-3 gap-6 border-y py-7">
    {stats.map((stat) => <StatTilePart value={stat.value} label={stat.label} bare />)}
  </div>

  <SegmentBarPart segments={eras} ariaLabel={s.career.timeline} />

  <ol class="border-line relative mt-12 space-y-14 border-s">
    {experience.map((role) => <RoleItem role={role} />)}
  </ol>

  <p class="rule mt-16"><span class="kicker">{s.career.education}</span></p>
  <ul class="mt-6 space-y-5">
    {
      education.map((entry) => (
        <li class="flex gap-4">
          <Icon
            name="lucide:graduation-cap"
            class="text-label mt-1 h-5 w-5 shrink-0"
            aria-hidden="true"
          />
          <div>
            <p class="font-display text-ink text-lg font-semibold">{entry.degree}</p>
            <p class="text-faint mt-0.5 text-sm">
              {entry.school}
              {entry.period && ` · ${entry.period}`}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
