---
// Big serif numeral over a small label. Two forms: a bordered card (the
// Career "at a glance" row) or `bare`, with no chrome at all, for a stat strip
// that sits directly on the page between hairlines.
interface Props {
  value: string;
  label: string;
  /** Drop the card border and padding. */
  bare?: boolean;
}

const { value, label, bare = false }: Props = Astro.props;
---

<div class:list={['text-center', bare ? 'px-2' : 'card p-4']}>
  <p class="figure text-3xl sm:text-4xl">
    {value}
  </p>
  <p class="text-faint mt-1 text-xs">{label}</p>
</div>
